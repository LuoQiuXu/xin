*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# Large image/feature banks, logits, scores, noise and mask arrays
*.npy
*.npz
*.h5
*.hdf5
*.pkl
*.pickle
# Small, locked data protocols and class statistics are useful for reproduction
!**/split_indices.npz
!**/sampling_plan.npz
!**/class_feature_statistics.npz

# Generated training outputs; keep canonical scripts/configuration outside these
outputs/
saved/
checkpoints/
feature_banks/
feature_cache/
