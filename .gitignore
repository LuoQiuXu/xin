runs/
wandb/
lightning_logs/
tmp/
temp/
*.log
*.out
*.tfevents.*
*.jsonl
*.ndjson
**/batches.csv
**/historical_before.json

# Redundant generated source snapshots; keep the actual runnable source
source_snapshot/
stage2_source_snapshot/

# Local editor/agent state and image inspection crops
.idea/
.vscode/
.agents/
.codex/
.codex-analysis-crops/
.codex-image-crops/
.codex-plan-crops/

# Local secrets (configuration JSON/YAML and summary CSV remain tracked)
.env
.env.*
!.env.example
!.env.sample
credentials.json
credentials.local.json
*service-account*.json

# OS metadata and temporary editor files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# Local audit caches (downloaded papers, page renders and intermediate extracts)
/H2T_repro_audit/**/primary_cache/

# Protected local-only historical probe assets, outside decision-ledger deliverables
/H2T_repro_audit/fusion_semantic_audit/diagnostics/single_batch_compute_20261025_01/
/H2T_repro_audit/fusion_semantic_audit/single_batch_compute_probe.py
/H2T_repro_audit/fusion_semantic_audit/test_single_batch_compute_probe.py

# Raw replay traces and generated reference-source copies from historical runs
/H2T_repro_audit/lowvs_mask_parity/results/**/batch_signatures.csv
/H2T_repro_audit/mdlt_domain_probe/output/reference_source/
# These per-run schedules override the generic sampling_plan.npz exception above
/H2T_repro_audit/mdlt_domain_probe/results/**/output/sampling_plan.npz

# Otherwise kept: *.py, *.yaml, *.yml, ordinary *.json, summary *.csv,
