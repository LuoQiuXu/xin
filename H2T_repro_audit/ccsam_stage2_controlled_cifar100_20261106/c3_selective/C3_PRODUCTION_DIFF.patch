+        raise ValueError("C3 expects one int64 label per feature row")
+    counts = torch.as_tensor(train_counts, dtype=torch.long, device=labels.device)
+    if counts.shape != (NUM_CLASSES,) or bool((counts <= 0).any().item()):
+        raise ValueError("C3 requires the sealed positive 100-class TRAIN counts")
+    if bool(((labels < 0) | (labels >= NUM_CLASSES)).any().item()):
+        raise ValueError("C3 label outside class range")
