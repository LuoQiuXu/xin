+        "mean_delta_l2_per_sample": float(delta_l2.mean().detach().cpu()),
+        "mean_relative_delta_l2": float((delta_l2 / gap_l2).mean().detach().cpu()),
+        "max_delta_l2_per_sample": float(delta_l2.max().detach().cpu()),
+    }
+    if not torch.isfinite(selected).all():
+        raise RuntimeError("Non-finite C3 selective feature delta")
+    return selected.detach(), stats
