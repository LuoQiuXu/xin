te_dict_sha(tensors):\n    digest = hashlib.sha256()\n    for name, tensor in tensors.items():\n        digest.update(name.encode(\"utf-8\"))\n        digest.update(tensor.detach().cpu().contiguous().numpy().tobytes())\n    return digest.hexdigest()\n\nexpected_backbone = state_dict_sha(checkpoint[\"state_dict_model\"])\nexpected_head = state_dict_sha(checkpoint[\"state_dict_classifier\"])\nassert [entry[\"seed\"] for entry in smoke[\"checks\"]] == list(c.SEEDS)\nfor entry in smoke[\"checks\"]:\n    seed = entry[\"seed\"]\n    assert entry[\"disposable_classifier_updated\"] and entry[\"backbone_and_bn_unchanged\"]\n    assert not (c.ROOT / \"results\" / f\"seed_{seed}\" / C3_ARM).exists()\n    c0 = c.ROOT / \"results\" / f\"seed_{seed}\" / \"C0_BALANCED_CE\"\n    status = c.read_json(c0 / \"status.json\")\n    assert status[\"initial_backbone_sha256\"] == expected_backbone\n    assert status[\"initial_classifier_sha256\"] == expected_head\n    reference = read_trace(c0 / \"batch_trace.csv\")\n    assert [batch[\"batch\"] for batch in entry[\"batches\"]] == [0, 1]\n    for batch in entry[\"batches\"]:\n        assert batch[\"gap_sha256\"] == reference[batch[\"batch\"]][\"gap_features_sha256\"]\n        for mask in batch[\"mask_checks\"].values():\n            assert mask[\"many_delta_zero_exact\"] and mask[\"nonmany_delta_equals_C1_bitwise\"]\n    print(f\"Smoke seed {seed}: both real GAP hashes match sealed C0, masks and disposable update passed\")\nassert not (C3_DIR / \"formal_completed.json\").exists()\nassert not c.guard_pass()[\"blocked_attempts\"]\nprint(\"C3 formal gate PASS: 52 original artifacts, all 16 input hashes, matching checkpoint initialization, TEST=0\")\nprint(f\"CUDA device: {torch.cuda.get_device_name(0)}\")\n"]}
