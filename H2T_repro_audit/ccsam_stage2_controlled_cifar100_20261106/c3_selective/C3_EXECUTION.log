"sha256\"], str(path)\nfor item in seal[\"inputs\"].values():\n    assert c.sha256_file(c.REPO_ROOT / item[\"path\"]) == item[\"sha256\"], item[\"path\"]\nhistorical = c.read_json(c.ROOT / \"validation_20261106_05/PRE_SWITCH_UNTRACKED.json\")\nfor name, item in historical.items():\n    assert c.sha256_file(c.REPO_ROOT / name) == item[\"sha256\"], name\n\nmanifest = c.read_json(c.ROOT / \"prepared/prepared_manifest.json\")\ncheckpoint = torch.load(c.resolve_checkpoint(manifest[\"checkpoint_path\"]), map_location=\"cpu\", weights_only=False)\ninitial = {name.removeprefix(\"module.\"): tensor for name, tensor in checkpoint[\"state_dict_classifier\"].items()}\ntrain_labels = np.load(c.ROOT / \"prepared/train_labels.npy\", mmap_mode=\"r\", allow_pickle=False)\nvalidation_labels = np.load(c.ROOT / \"prepared/validation_labels.npy\", mmap_mode=\"r\", allow_pickle=False)\nassert manifest[\"train_class_counts\"][0] == 500 and not np.any(validation_labels == 0)\ndetails = []\nfor completion in done[\"runs\"]:\n    seed = completion[\"seed\"]\n    output = c.ROOT / \"results\" / f\"seed_{seed}\" / C3_ARM\n    c0 = output.parent / \"C0_BALANCED_CE\"\n    status = c.read_json(output / \"status.json\")\n    original_status = c.read_json(c0 / \"status.json\")\n    assert status[\"seed\"] == seed and status[\"arm\"] == C3_ARM\n    assert status[\"state\"] == \"completed\" and status[\"final_epoch\"] == completion[\"epoch\"] == 30\n    assert status[\"official_TEST_used\"] is False and status[\"backbone_frozen\"] and status[\"bn_eval_and_buffers_frozen\"]\n    assert status[\"optimizer\"] == original_status[\"optimizer\"]\n    for name in (\"initial_classifier_sha256\", \"initial_backbone_sha256\", \"clean_stage1_sha256\"):\n        assert status[name] == original_status[name], f\"{seed} {name}\"\n    epochs = status[\"epochs\"]\n    metrics = read_trace(output / \"metrics.csv\")\n    assert len(metrics) == len(epochs) == 30\n    trace = read_trace(output / \"batch_trace.csv\")\n    assert len(trace) == 5100\n    trace_sha = c.sha256_file(output / \"batch_trace.csv\")\n    assert trace_sha == c.sha256_file(c0 / \"batch_trace.csv\")\n    for epoch_index, (row, recorded) in enumerate(zip(metrics, epochs)):\n        assert int(row[\"epoch\"]) == recorded[\"epoch\"] == epoch_index + 1\n        assert all(math.isfinite(float(value)) for value in row.values())\n        assert int(row[\"samples\"]) == c.TRAIN_SAMPLES == 10847\n        assert int(row[\"steps\"]) == 170\n        assert float(row[\"learning_rate\"]) == c.STAGE2_LR\n        assert float(row[\"alpha\"]) == c.alpha_for_epoch(epoch_index)\n        assert float(row[\"mean_delta_l2_per_sample\"]) > 0\n        assert recorded[\"frozen_backbone_and_bn_bitwise_unchanged\"] is True\n        assert int(trace[(epoch_index + 1) * 170 - 1][\"batch_size\"]) == 31\n    checkpoint_file = output / \"final_classifier.pth\"\n    checkpoint_sha = c.sha256_file(checkpoint_file)\n    assert checkpoint_sha == status[\"final_classifier_sha256\"] == completion[\"final_classifier_sha256\"]\n    final = torch.load(checkpoint_file, map_location=\"cpu\", weights_only=True)\n    assert final[\"seed\"] == seed and final[\"arm\"] == C3_ARM and final[\"epoch\"] == 30\n    assert final[\"official_TEST_used\"] is False and final[\"backbone_retrained\"] is False\n    assert final[\"primary_epoch_fixed\"] is True and final[\"initial_classifier_sha256\"] == status[\"initial_classifier_sha256\"]\n    assert final[\"final_validation\"] == status[\"final_validation\"]\n    parameters = final[\"state_dict_classifier\"]\n    assert parameters.keys() == initial.keys()\n    assert all(tensor.dtype == torch.float32 and torch.isfinite(tensor).all() for tensor in parameters.values())\n    assert any(not torch.equal(tensor, initial[name]) for name, tensor in parameters.items())\n    for path in (output / \"batch_trace.csv\", checkpoint_file):\n        subprocess.run([\"git\", \"check-ignore\", \"--quiet\", \"--\", str(path)], check=True)\n    plan_path = c.ROOT / \"prepared\" / manifest[\"sampling_plans\"][str(seed)][\"path\"]\n    plan = np.load(plan_path, mmap_mode=\"r\", allow_pickle=False)\n    class_0_samples = int(np.count_nonzero(train_labels[plan] == 0))\n    assert class_0_samples > 0\n    details.append({\n        \"seed\": seed, \"epochs\": len(epochs), \"many_class_0_samples_masked\": class_0_samples,\n        \"optimizer_steps\": sum(int(row[\"steps\"]) for row in metrics),\n        \"train_samples_seen\": sum(int(row[\"samples\"]) for row in metrics),\n        \"classifier_updated\": True,\n        \"initial_classifier_sha256\": status[\"initial_classifier_sha256\"],\n        \"initial_backbone_sha256\": status[\"initial_backbone_sha256\"],\n        \"backbone_bn_bitwise_frozen_every_epoch\": True,\n        \"batch_trace_path\": (output / \"batch_trace.csv\").relative_to(c.ROOT).as_posix(),\n        \"batch_trace_sha256\": trace_sha,\n        \"matched_c0_batches\": len(trace),\n        \"classifier_path\": checkpoint_file.relative_to(c.ROOT).as_posix(),\n        \"classifier_sha256\": checkpoint_sha,\n        \"last_epoch_mean_delta_l2\": float(metrics[-1][\"mean_delta_l2_per_sample\"]),\n        \"last_epoch_metrics\": {key: status[\"final_validation\"][key] for key in (\"Overall\", \"Many\", \"MediumN\", \"Few\")},\n    })\nepochs = sum(item[\"epochs\"] for item in details)\nsteps = sum(item[\"optimizer_steps\"] for item in details)\nsamples = sum(item[\"train_samples_seen\"] for item in details)\nassert (epochs, steps, samples) == (90, 15300, 976230)\nexclusive_json(C3_DIR / \"C3_FORMAL_VERIFICATION.json\", {\n    \"passed\": True, \"actual_seeds_completed\": len(details), \"actual_epochs\": epochs,\n    \"actual_optimizer_steps\": steps, \"actual_train_samples_seen\": samples, \"runs\": details,\n    \"original_artifacts_verified\": len(originals), \"sealed_inputs_verified\": len(seal[\"inputs\"]),\n    \"historical_untracked_assets_verified\": len(historical), \"protected_file