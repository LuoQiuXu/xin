+    if sha256_file(OFFICIAL_SAMPLER_SOURCE) != OFFICIAL_SAMPLER_SHA256:
+        raise RuntimeError("Pinned official CC-SAM sampler source checksum mismatch")
+    rng_state = random.getstate()
