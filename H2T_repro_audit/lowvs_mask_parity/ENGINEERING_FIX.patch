+def audit_data(s,inputs):
+    raw=s.REPO/'H2T/data/cifar100/cifar-100-python/train'
+    raw_sha=s.sha(raw)
+    assert raw_sha=='735e79b04f092ca3d2e6d07f368c0a7d70d48c48d28865950cc24454cf45129b'
+    with raw.open('rb') as f:original=pickle.load(f,encoding='latin1')
+    pixels=original['data'].reshape(50000,3,32,32).transpose(0,2,3,1)
+    original_y=np.asarray(original['fine_labels'],dtype=np.int64)
+    with np.load(inputs['split'],allow_pickle=False) as split:
+        train_id=split['train_raw_indices'].copy(); val_id=split['validation_raw_indices'].copy()
+    y=np.load(inputs['train_labels'],allow_pickle=False);vy=np.load(inputs['validation_labels'],allow_pickle=False)
