+def warmup(s,bb,transform,inputs):
+    images=np.load(inputs['train_images'],mmap_mode='r',allow_pickle=False)[:128]
+    with torch.no_grad():
+        x=torch.stack([transform['eval_transform'](s.Image.fromarray(v)) for v in images]).cuda()
+        bb(x);bb(x)
+    torch.cuda.synchronize()
