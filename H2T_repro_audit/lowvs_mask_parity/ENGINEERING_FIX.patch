+def check_preflight(s,seed=None):
+    record=json.loads((s.RESULTS/'preflight.json').read_text(encoding='utf-8'))
+    assert record['status']=='PASS' and record['source_hashes']==source_hashes(s)
+    unit=json.loads((s.RESULTS/'unit.json').read_text(encoding='utf-8'))
+    assert unit['status']=='PASS' and unit['source_hashes']==source_hashes(s)
+    verify_history(s,record['historical_sha256'])
+    if seed is not None:
+        _,digests=s.input_manifest(seed)
+        assert digests==record['seeds'][str(seed)]['input_sha256']
+    return record
