+    assert np.isfinite(noise).all() and np.isfinite(maps).all()
+    return {'raw_TRAIN_sha256':raw_sha,'LT_counts':counts.tolist(),'LT_official_seed0_replay_exact':True,
+            'LT_pixels_and_labels_match_raw_TRAIN':True,'TRAIN_validation_index_overlap':0,
+            'TRAIN_raw_indices_sha256':s.array_hash(train_id),'validation_raw_indices_sha256':s.array_hash(val_id),
