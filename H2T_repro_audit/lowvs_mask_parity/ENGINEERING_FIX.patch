+    counts=np.bincount(y,minlength=100)
+    expected_counts=np.array([int(500*(.01**(c/99))) for c in range(100)])
+    assert np.array_equal(counts,expected_counts) and counts.sum()==10847
+    rng=np.random.RandomState(0);replayed=[]
+    for c in range(100):
+        ids=np.flatnonzero(original_y==c);rng.shuffle(ids);replayed.extend(ids[:counts[c]].tolist())
+    assert np.array_equal(train_id,np.asarray(replayed,dtype=np.int64))
+    assert len(np.unique(train_id))==10847 and len(np.unique(val_id))==1980
+    assert ((val_id>=0)&(val_id<50000)).all() and not np.intersect1d(train_id,val_id).size
+    assert images.shape==(10847,32,32,3) and images.dtype==np.uint8
+    assert np.array_equal(images,pixels[train_id]) and np.array_equal(y,original_y[train_id])
+    assert np.array_equal(vy,original_y[val_id]) and np.bincount(vy,minlength=100).tolist()==[0]+[20]*99
+    with np.load(inputs['plan'],allow_pickle=False) as plan:
