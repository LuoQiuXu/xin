+"""Run-integrity evidence only. Mask policy, score, optimizer and schedule are unchanged."""
+from pathlib import Path
+import datetime, hashlib, importlib.metadata, json, os, pickle, sys, time
+import numpy as np
+import torch
+
+WRITES=[]
+
+def stamp():
+    return datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=8))).isoformat(timespec='seconds')
+
+def source_hashes(s):
+    names=('run_parity.py','mask_policy.py','test_mask_policy.py','audit_support.py','PROTOCOL.md','CODEX_LOWVS_MASK_PARITY.txt')
+    paths=[s.HERE/n for n in names]
+    paths += [s.OLD/n for n in ('common.py','stability_models.py','online_policy.py','reused_train_helpers.py','reused_vs_math.py')]
+    return {p.relative_to(s.REPO).as_posix():s.sha(p) for p in paths}
+
+def software():
+    return {'python':sys.executable,'python_version':sys.version,'torch':torch.__version__,
+            'torchvision':importlib.metadata.version('torchvision'),'numpy':np.__version__,
+            'CUDA':torch.version.cuda,'cudnn':torch.backends.cudnn.version()}
+
+def environment():
+    return {**software(),'device':torch.cuda.get_device_name(0),
+            'device_total_mib':torch.cuda.get_device_properties(0).total_memory/1024**2,
+            'cudnn_benchmark':torch.backends.cudnn.benchmark,
+            'cudnn_deterministic':torch.backends.cudnn.deterministic,
+            'cudnn_allow_tf32':torch.backends.cudnn.allow_tf32,
+            'matmul_allow_tf32':torch.backends.cuda.matmul.allow_tf32,
+            'deterministic_algorithms':torch.are_deterministic_algorithms_enabled(),
+            'torch_num_threads':torch.get_num_threads(),'default_dtype':str(torch.get_default_dtype()),
+            'CUBLAS_WORKSPACE_CONFIG':os.environ.get('CUBLAS_WORKSPACE_CONFIG')}
+
+def write_guard(s):
+    root=str(s.REPO.resolve()).casefold(); allowed=str(s.RESULTS.resolve()).casefold()
+    def check(path,event):
+        if not isinstance(path,(str,bytes,os.PathLike)):return
+        key=str(Path(os.fsdecode(path)).resolve()).casefold()
+        if (key==root or key.startswith(root+os.sep)) and not (key==allowed or key.startswith(allowed+os.sep)):
+            WRITES.append({'event':event,'path':key})
+            raise RuntimeError('Historical/source write outside new results/ prohibited: '+key)
+    def audit(event,args):
+        if event=='open' and args:
+            mode=args[1] if len(args)>1 else None; flags=args[2] if len(args)>2 else 0
+            if (isinstance(mode,str) and any(k in mode for k in 'wax+')) or (isinstance(flags,int) and flags&(os.O_WRONLY|os.O_RDWR|os.O_CREAT|os.O_TRUNC|os.O_APPEND)):
+                check(args[0],event)
+        elif event in ('os.remove','os.rmdir','os.mkdir','os.rename','os.chmod','os.utime','os.link','os.symlink'):
+            for path in args[:2]:check(path,event)
+    sys.addaudithook(audit)
+
+def bn_hash(s,bb):
+    arrays=[v.detach().cpu().numpy() for k,v in bb.state_dict().items() if k.endswith(('running_mean','running_var','num_batches_tracked'))]
+    return s.array_hash(*arrays)
+
+def historical_manifest(s):
+    lock=json.loads((s.OLD/'source_lock.json').read_text(encoding='utf-8'))
+    paths={s.OLD/'source_lock.json'}
+    for category in ('files','data_files'):
+        for rel,expected in lock[category].items():
+            p=s.OLD/rel
+            assert s.sha(p)==expected,('Historical lock mismatch',str(p))
+            paths.add(p)
