+def preflight_seed(s,seed,inputs):
+    data=audit_data(s,inputs)
+    def trial():
+        cfg,tr,bb,cls,CE,_,stage1,q=s.frozen_models(seed)
+        frozen={k:v.detach().cpu().clone() for k,v in bb.state_dict().items()}
+        initial={'backbone':s.state_hash(bb),'classifier':s.state_hash(cls),'BN':bn_hash(s,bb)}
+        warmup(s,bb,tr,inputs)
+        y=np.load(inputs['train_labels'],allow_pickle=False)
+        with np.load(inputs['plan'],allow_pickle=False) as plan:
+            rec=plan['receivers'][0,:128].copy();don=plan['donors'][0,:128].copy()
+        noise=np.load(inputs['noise'],mmap_mode='r',allow_pickle=False)[0,:128]
+        aug=torch.Generator().manual_seed(seed+300009)
+        ri,di=s.augment(rec,don,aug,tr['train_transform'])
+        with torch.no_grad():receiver=bb(ri.cuda());donor=bb(di.cuda())
+        assert receiver.shape==donor.shape==(128,64,8,8) and not receiver.requires_grad and not donor.requires_grad
+        trace=s.online_masks(receiver,y[don],noise)
+        sig=s.signature(0,0,rec,don,y,ri,di,receiver,donor,noise,trace,aug)
+        evidence={}
+        target=torch.from_numpy(y[rec].copy()).cuda()
+        criterion=CE(cfg,np.bincount(y,minlength=100)).cuda()
+        for arm in s.ARMS:
+            chosen=s.choose_masks(arm,trace,noise)
+            with torch.no_grad():
+                fused,mask=s.fuse(receiver,donor,chosen);full=mask[:,:,None,None].expand_as(fused)
+                assert torch.equal(fused[full],donor[full]) and torch.equal(fused[~full],receiver[~full])
+                assert np.array_equal(target.cpu().numpy(),y[rec])
+                z=cls(fused);loss=criterion(z,target,extra_info=None)
+                assert z.shape==(128,100) and torch.isfinite(z).all() and torch.isfinite(loss)
+            after=s.signature(0,0,rec,don,y,ri,di,receiver,donor,noise,trace,aug)
+            assert all(str(sig[k])==str(after[k]) for k in s.PAIR_KEYS),'Mask policy perturbed paired input/RNG'
+            evidence[arm]={'mask_sha256':s.array_hash(chosen),'CE_without_updates':float(loss),'full_channel_copy_exact':True}
+        s.check_frozen(bb,frozen)
+        assert s.state_hash(cls)==initial['classifier'] and all(p.grad is None for p in cls.parameters())
+        assert bn_hash(s,bb)==initial['BN']
+        return {'initial':initial,'signature':sig,'policies':evidence,'environment':environment(),
+                'backbone_state_entries':len(frozen),'BN_counters':sorted({int(v) for k,v in frozen.items() if k.endswith('num_batches_tracked')}),
+                'classifier_parameters':sum(p.numel() for p in cls.parameters()),'optimizer_updates':0}
+    first,second=trial(),trial()
+    assert first['initial']==second['initial'] and first['environment']==second['environment']
+    mismatch=[k for k in s.PAIR_KEYS if str(first['signature'][k])!=str(second['signature'][k])]
+    if mismatch:
+        s.dump(s.RESULTS/'PREFLIGHT_PAIRING_FAILURE.json',{'seed':seed,'fields':mismatch,'expected':first,'actual':second})
+        raise RuntimeError('Fresh-model preflight parity mismatch: '+str(mismatch))
+    first.update({'data':data,'fresh_model_replay_13_fields_exact':True})
+    return first
