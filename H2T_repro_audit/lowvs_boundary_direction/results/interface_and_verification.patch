+def verify_geometry(zr,zh,y,uniform,lowvs,W,b,data):
+    # Direct logits, independent of n*q, verify the stated fixed-margin identity.
+    row=np.arange(len(y));comp=data["competitor_class"]
+    clean=zr.astype(np.float64)@W.T+b
+    masked=clean.copy();masked[row,y]=-np.inf
+    assert np.array_equal(comp,masked.argmax(1)) and (comp!=y).all()
+    clean_margin=clean[row,y]-clean[row,comp]
+    delta=zh.astype(np.float64)-zr.astype(np.float64)
+    shifts={}
+    for tag,indices,norm in (("u",uniform,data["nu"]),("l",lowvs,data["nl"])):
+        d=np.zeros_like(delta);d[row[:,None],indices]=delta[row[:,None],indices]
+        actual_norm=np.linalg.norm(d,axis=1)
+        assert np.allclose(actual_norm,norm,atol=1e-12,rtol=1e-12)
+        scaled=d*data["alpha_"+tag][:,None]
+        for key,vector in (("full",d),("matched",scaled)):
+            logits=(zr.astype(np.float64)+vector)@W.T+b
+            actual=logits[row,y]-logits[row,comp]-clean_margin
+            expected=data[key+"_margin_delta_"+tag]
+            assert np.allclose(actual,expected,atol=1e-9,rtol=1e-9)
+            shifts[key+"_"+tag]=actual
+        data["matched_norm_actual_"+tag]=np.linalg.norm(scaled,axis=1)
+        assert np.allclose(data["matched_norm_actual_"+tag],data["r"],atol=1e-9,rtol=1e-9)
+        mismatch=(data["q_"+tag]<0)!=(shifts["full_"+tag]<0)
+        assert not (mismatch & (np.abs(shifts["full_"+tag])>1e-9)).any()
+        data["sign_mismatch_"+tag]=mismatch
+    full=shifts["full_l"]-shifts["full_u"]
+    matched=shifts["matched_l"]-shifts["matched_u"]
+    residual=full-data["margin_diff_direction_at_r"]-data["margin_diff_extra_magnitude"]
+    assert np.allclose(residual,0,atol=1e-9,rtol=0)
+    assert np.allclose(matched,data["margin_diff_direction_at_r"],atol=1e-9,rtol=1e-9)
+    data["direct_full_margin_contrast"]=full
+    data["direct_matched_margin_contrast"]=matched
+    data["independent_identity_residual"]=residual
+
+
